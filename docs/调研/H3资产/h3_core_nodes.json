           "tooltip": "Reference video frames at 24 fps (2-15s)"
          }
         ]
        }
       },
       "prefix": "ref_video_",
       "min": 0,
       "max": 3
      }
     }
    ],
    "ref_video_audios": [
     "COMFY_AUTOGROW_V3",
     {
      "template": {
       "input": {
        "required": {
         "ref_video_audio": [
          "AUDIO",
          {
           "tooltip": "Soundtrack of the same-numbered reference video"
          }
         ]
        }
       },
       "prefix": "ref_video_audio_",
       "min": 0,
       "max": 3
      }
     }
    ],
    "ref_audios": [
     "COMFY_AUTOGROW_V3",
     {
      "template": {
       "input": {
        "required": {
         "ref_audio": [
          "AUDIO",
          {
           "tooltip": "Standalone reference audio"
          }
         ]
        }
       },
       "prefix": "ref_audio_",
       "min": 0,
       "max": 3
      }
     }
    ]
   }
