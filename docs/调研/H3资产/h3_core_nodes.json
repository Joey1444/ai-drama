      "default": "described_voice",
      "multiselect": false,
      "options": [
       "described_voice",
       "reference_voice"
      ]
     }
    ],
    "speaker_id": [
     "STRING",
     {
      "default": "speaker_1",
      "multiline": false
     }
    ],
    "voice_description": [
     "STRING",
     {
      "default": "an adult speaker with a natural warm voice, clear diction, human micro-pauses, and close conversational delivery",
      "multiline": true
     }
    ],
    "language": [
     "COMBO",
     {
      "default": "Chinese",
      "multiselect": false,
      "options": [
