      "advanced": true,
      "default": true
     }
    ],
    "peak_limit_minus_3_dbfs": [
     "BOOLEAN",
     {
      "tooltip": "Only attenuates peaks above -3 dBFS; it never boosts quiet references.",
      "advanced": true,
      "default": true
     }
    ]
   },
   "optional": {
    "reference_audio": [
